{
  "Role": "arn:aws:iam::866934333672:role/S3ReplicationRole-EnhanceIT",
  "Rules": [
    {
      "ID": "replicate-critical-prefix",
      "Priority": 1,
      "Status": "Enabled",
      "Filter": {
        "Prefix": "critical/"
      },
      "DeleteMarkerReplication": {
        "Status": "Enabled"
      },
      "Destination": {
        "Bucket": "arn:aws:s3:::enhanceit-replica-eu-west-1",
        "StorageClass": "STANDARD"
      }
    },
    {
      "ID": "replicate-tagged-objects",
      "Priority": 2,
      "Status": "Enabled",
      "Filter": {
        "Tag": {
          "Key": "replicate",
          "Value": "true"
        }
      },
      "DeleteMarkerReplication": {
        "Status": "Disabled"
      },
      "Destination": {
        "Bucket": "arn:aws:s3:::enhanceit-replica-eu-west-1",
        "StorageClass": "STANDARD"
      }
    }
  ]
}
